# ─── SERVER ─────────────────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# ─── AUTH ────────────────────────────────────────────────────────────
# Required in production. Leave LOGIN_PASSWORD blank to disable auth (dev only).
LOGIN_PASSWORD=your_secure_password_here
SESSION_SECRET=generate_a_long_random_string_here

# ─── BUSINESS ────────────────────────────────────────────────────────
COACH_NAME=Kash
BUSINESS_NAME=Kash Performance Group
WEBSITE_URL=https://kash-performance-group.com

# ─── DATABASE ────────────────────────────────────────────────────────
# Local dev: leave as ./business.db
# Railway: set to /app/data/business.db AND mount volume at /app/data (not /app)
DB_PATH=./business.db

# ─── STRIPE ──────────────────────────────────────────────────────────
# Required for Stripe webhook + income logging
# Dashboard > Developers > API Keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Your Stripe payment link (shown in CRM proposal emails)
STRIPE_PAYMENT_LINK=https://buy.stripe.com/...

# ─── MAILCHIMP ───────────────────────────────────────────────────────
# Required for email automations
# Account > Profile > Extras > API Keys
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
# Audience > Settings > Audience name and defaults > Audience ID
MAILCHIMP_LIST_ID=abc123def4
# From address used in all automated emails
MAILCHIMP_FROM_EMAIL=kash@kash-performance-group.com
MAILCHIMP_FROM_NAME=Kash Performance Group
# Mailchimp datacenter (last part of API key, e.g. us21)
MAILCHIMP_DC=us21

# ─── TWILIO SMS (optional) ───────────────────────────────────────────
# Optional: SMS notifications. App works without this.
# console.twilio.com > Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ─── META ADS ────────────────────────────────────────────────────────
# Required for Meta Ads dashboard
# developers.facebook.com > My Apps > Tools > Graph API Explorer
# Generate a long-lived token with ads_read permission
META_ACCESS_TOKEN=EAAxxxxxxx...
# business.facebook.com > Ad Account > Settings > Account ID (format: act_XXXXXXX)
META_AD_ACCOUNT_ID=act_123456789

# ─── GOOGLE ──────────────────────────────────────────────────────────
# Required for Google Sheets sync
# console.cloud.google.com > IAM > Service Accounts > Create Key (JSON)
# Paste the ENTIRE contents of the JSON file as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# The spreadsheet ID from the URL: docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEETS_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
# Optional: Google Calendar ID for task sync
GOOGLE_CALENDAR_ID=primary

# ─── APIFY (social scraping) ─────────────────────────────────────────
# Required for Content Analytics scraping
# console.apify.com > Settings > Integrations > API Token
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your channel/profile handles (no @ symbol)
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@YourChannel
TIKTOK_USERNAME=yourtiktokhandle
INSTAGRAM_USERNAME=yourinstagramhandle

# ─── CALENDLY ────────────────────────────────────────────────────────
# Required for Calendly webhook
# calendly.com > Integrations > API & Webhooks
CALENDLY_API_KEY=eyJxxxxxxxxxx
# Your booking page URL (used in automation emails)
CALENDLY_BOOKING_URL=https://calendly.com/kash-performance/discovery

# ─── TYPEFORM ────────────────────────────────────────────────────────
TYPEFORM_API_KEY=tfp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your feedback form URL (used in monthly check-in emails)
TYPEFORM_FEEDBACK_URL=https://yourform.typeform.com/to/xxxxxxxx

# ─── FORMSPREE ───────────────────────────────────────────────────────
# Your Formspree form ID (for website contact form webhook)
FORMSPREE_FORM_ID=mgoryanp

# ─── ANTHROPIC AI ───────────────────────────────────────────────────
# Required for AI client insights in CRM
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── MANYCHAT ────────────────────────────────────────────────────────
MANYCHAT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
